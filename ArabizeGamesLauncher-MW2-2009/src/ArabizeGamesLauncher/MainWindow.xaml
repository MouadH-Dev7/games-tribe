<Window x:Class="ArabizeGamesLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:ArabizeGamesLauncher.Infrastructure"
        Title="Arabize Games" Width="1100" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        FlowDirection="{Binding WindowFlowDirection}">
  <Window.Resources>
    <infra:PageVisibilityConverter x:Key="PageVisibilityConverter" />
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
            <TextBlock Text="AG" Foreground="#0B0D12" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Texts[Brand], Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="{Binding Texts[AppTitle], Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Texts[BrandLine], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13,9" Margin="4">
            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding GameStatusText}" FontSize="12"/></StackPanel>
          </Border>
          <Button Content="{Binding Texts[Arabic], Mode=OneWay}" Command="{Binding SetArabicCommand}"/>
          <Button Content="{Binding Texts[English], Mode=OneWay}" Command="{Binding SetEnglishCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,14,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Margin="4,14,4,2">
            <Border Background="{StaticResource ElevatedBrush}" CornerRadius="12" Padding="13" Margin="0,0,0,12">
              <StackPanel><TextBlock Text="ARABIZE GAMES" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding Texts[VersionLabel], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
            </Border>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding Texts[Dashboard], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="12,10,12,9"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[Dashboard], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[Detection], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Detection"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[GameLanguagePage], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="GameLanguage"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[Packages], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Packages"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[History], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="History"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[Reports], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[Settings], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            <Button Style="{StaticResource NavButton}" Content="{Binding Texts[Activity], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Activity"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,10">
        <StackPanel>
          <TextBlock Text="{Binding CurrentPageTitle}" FontSize="28" FontWeight="SemiBold" Margin="8,5,8,0"/>
          <TextBlock Text="{Binding Texts[Subtitle], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="8,5,8,14"/>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
            <StackPanel>
              <UniformGrid Columns="2">
                <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[GameCard], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding GameIdentityText}" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,5"/><TextBlock Text="{Binding GameStatusText}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding GameDirectory}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[PackageStatus], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding PackageStatusText}" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,5"/><TextBlock Text="{Binding Texts[ArchiveFinding], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/><Button Content="{Binding Texts[Packages], Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Packages" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel></Border>
              </UniformGrid>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[Path], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/><DockPanel Margin="0,9,0,5"><Button DockPanel.Dock="Right" Content="{Binding Texts[Browse], Mode=OneWay}" Command="{Binding BrowseGameCommand}"/><TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" VerticalContentAlignment="Center"/></DockPanel><WrapPanel HorizontalAlignment="Right"><Button Content="{Binding Texts[DetectNow], Mode=OneWay}" Command="{Binding ValidateGameCommand}" Background="{StaticResource AccentBrush}" Foreground="#0B0D12" FontWeight="SemiBold"/><Button Content="{Binding Texts[Launch], Mode=OneWay}" Command="{Binding LaunchGameCommand}" ToolTip="{Binding LaunchStatusText}"/></WrapPanel><TextBlock Text="{Binding LaunchStatusText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[SafetyNotice], Mode=OneWay}" Foreground="{StaticResource InfoBrush}" FontSize="14"/><ProgressBar Value="{Binding InstallProgress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,15,0,10" Background="{StaticResource ElevatedBrush}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Texts[Progress], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/><WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="{Binding Texts[Install], Mode=OneWay}" IsEnabled="False" ToolTip="{Binding Texts[SafetyNotice], Mode=OneWay}"/><Button Content="{Binding Texts[Restore], Mode=OneWay}" IsEnabled="False" ToolTip="{Binding Texts[SafetyNotice], Mode=OneWay}"/></WrapPanel></StackPanel></Border>
            </StackPanel>
          </Grid>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Detection}">
            <StackPanel>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[GameName], Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Texts[Path], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,15,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="{Binding Texts[Browse], Mode=OneWay}" Command="{Binding BrowseGameCommand}"/><TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight"/></DockPanel><WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="{Binding Texts[DetectNow], Mode=OneWay}" Command="{Binding ValidateGameCommand}" Background="{StaticResource AccentBrush}" Foreground="#0B0D12" FontWeight="SemiBold"/><TextBlock Text="{Binding GameStatusText}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="10,0"/></WrapPanel></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[Evidence], Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding GameMessage}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,12"/><ItemsControl ItemsSource="{Binding GameEvidence}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource ElevatedBrush}" CornerRadius="9" Padding="12,9" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FlowDirection="LeftToRight"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </StackPanel>
          </Grid>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=GameLanguage}">
            <StackPanel>
              <Border Style="{StaticResource CardBorder}"><StackPanel>
                <TextBlock Text="{Binding Texts[InterfaceLanguageSection], Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Texts[UiLanguage], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,6"/>
                <WrapPanel><Button Content="{Binding Texts[Arabic], Mode=OneWay}" Command="{Binding SetArabicCommand}"/><Button Content="{Binding Texts[English], Mode=OneWay}" Command="{Binding SetEnglishCommand}"/></WrapPanel>
              </StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel>
                <TextBlock Text="{Binding Texts[GameLanguageSection], Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,8,0,8"><Button Content="{Binding Texts[GameLanguageArabic], Mode=OneWay}" Command="{Binding SelectArabicGameLanguageCommand}"/><Button Content="{Binding Texts[GameLanguageEnglish], Mode=OneWay}" Command="{Binding SelectEnglishGameLanguageCommand}"/></WrapPanel>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[SelectedGameLanguage], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding SelectedGameLanguageText, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[GameCompatibility], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding GameCompatibilityText, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[Identity], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding GameIdentityText, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[GameVersion], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding GameBuildText, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[GameBuildName], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding GameBuildNameText, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding GameDirectory}" FlowDirection="LeftToRight" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[CurrentGameLanguage], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding CurrentGameLanguageText, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[RegistryStatus], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryConfigurationText, Mode=OneWay}"/></TextBlock>
                <Button Content="{Binding Texts[InspectCurrentSettings], Mode=OneWay}" Command="{Binding InspectRegistryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <TextBlock Margin="0,8"><Run Text="{Binding Texts[InspectionTimestamp], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryInspectionTimeText, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding RegistryInspectionErrorText, Mode=OneWay}" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"/>
                <Border Background="{StaticResource ElevatedBrush}" CornerRadius="9" Padding="12" Margin="0,8,0,0"><StackPanel>
                  <TextBlock Text="{Binding Texts[LocaleValue], Mode=OneWay}" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,5"><Run Text="{Binding Texts[ValueState], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryLocaleStatusText, Mode=OneWay}"/></TextBlock>
                  <TextBlock Margin="0,3" FlowDirection="LeftToRight"><Run Text="{Binding Texts[ValueData], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryLocaleDataText, Mode=OneWay}"/></TextBlock>
                  <TextBlock Margin="0,3" FlowDirection="LeftToRight"><Run Text="{Binding Texts[ValueType], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryLocaleKindText, Mode=OneWay}"/></TextBlock>
                </StackPanel></Border>
                <Border Background="{StaticResource ElevatedBrush}" CornerRadius="9" Padding="12" Margin="0,8,0,0"><StackPanel>
                  <TextBlock Text="{Binding Texts[LocaleAudioValue], Mode=OneWay}" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,5"><Run Text="{Binding Texts[ValueState], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryLocaleAudioStatusText, Mode=OneWay}"/></TextBlock>
                  <TextBlock Margin="0,3" FlowDirection="LeftToRight"><Run Text="{Binding Texts[ValueData], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryLocaleAudioDataText, Mode=OneWay}"/></TextBlock>
                  <TextBlock Margin="0,3" FlowDirection="LeftToRight"><Run Text="{Binding Texts[ValueType], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryLocaleAudioKindText, Mode=OneWay}"/></TextBlock>
                </StackPanel></Border>
                <TextBlock Text="{Binding Texts[ArabicAudioNote], Mode=OneWay}" Foreground="{StaticResource InfoBrush}" Margin="0,8,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel>
                <TextBlock Text="{Binding Texts[AvailableSnapshots], Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SnapshotListStatusText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                <DockPanel Margin="0,5,0,8"><Button DockPanel.Dock="Right" Content="{Binding Texts[RefreshSnapshots], Mode=OneWay}" Command="{Binding RefreshRegistrySnapshotsCommand}"/><ComboBox ItemsSource="{Binding RegistrySnapshots}" SelectedItem="{Binding SelectedRegistrySnapshot}" MinWidth="320" IsSynchronizedWithCurrentItem="False"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Envelope.Snapshot.TransactionId}" FlowDirection="LeftToRight"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
                <TextBlock Text="{Binding SelectedSnapshotDetailsText, Mode=OneWay}" FlowDirection="LeftToRight" TextWrapping="Wrap" Background="{StaticResource ElevatedBrush}" Padding="10"/>
                <TextBlock Text="{Binding RestoreStatusText, Mode=OneWay}" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding RestoreReadinessText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel>
                <TextBlock Text="{Binding Texts[TargetConfiguration], Mode=OneWay}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TargetRegistryValuesText, Mode=OneWay}" FlowDirection="LeftToRight" Margin="0,5,0,8"/>
                <WrapPanel><Button Content="{Binding Texts[ApplyLanguage], Mode=OneWay}" Command="{Binding ApplyGameLanguageCommand}"/><Button Content="{Binding Texts[RestorePreviousSettings], Mode=OneWay}" Command="{Binding RestorePreviousSettingsCommand}"/><Button Content="{Binding Texts[LaunchGame], Mode=OneWay}" Command="{Binding LaunchGameCommand}"/></WrapPanel>
                <TextBlock Text="{Binding ApplyLanguageStatusText, Mode=OneWay}" Foreground="{StaticResource InfoBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[BackupStatus], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryBackupStatusText, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[TransactionProgress], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryTransactionProgressText, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding RegistryTransactionDetailsText, Mode=OneWay}" TextWrapping="Wrap" FlowDirection="LeftToRight" Margin="0,5"/>
                <TextBlock Margin="0,5"><Run Text="{Binding Texts[RollbackStatus], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RegistryRollbackStatusText, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding LaunchStatusText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Packages}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[PackageLibrary], Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding PackageDirectory}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,7,0,10" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/><WrapPanel><Button Content="{Binding Texts[ImportPackages], Mode=OneWay}" Command="{Binding BrowsePackageCommand}"/><Button Content="{Binding Texts[Refresh], Mode=OneWay}" Command="{Binding RefreshPackagesCommand}"/></WrapPanel><ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" MinHeight="130" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding Texts[PackageEmpty], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/></StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[PackageDetails], Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedPackage.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{Binding PackageDetailsText}" Foreground="{StaticResource InfoBrush}"/><Separator Margin="0,12" Background="{StaticResource BorderBrush}"/><TextBlock><Run Text="{Binding Texts[Status], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding SelectedPackageStatusText, Mode=OneWay}"/></TextBlock><TextBlock Margin="0,6"><Run Text="{Binding Texts[PackageVersion], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding SelectedPackage.Version, Mode=OneWay}"/></TextBlock><TextBlock Margin="0,6"><Run Text="{Binding Texts[Language], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding SelectedPackage.Language, Mode=OneWay}"/></TextBlock><TextBlock Margin="0,6"><Run Text="{Binding Texts[Files], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding SelectedPackage.FileCount, Mode=OneWay}"/></TextBlock><TextBlock Margin="0,6"><Run Text="{Binding Texts[Method], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding SelectedPackage.InstallationMethod, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding SelectedPackage.CompatibilityNotes}" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding Texts[SafetyNotice], Mode=OneWay}" Foreground="{StaticResource InfoBrush}" Margin="0,14,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=History}">
            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[History], Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Texts[NoTransactions], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,9"/><ItemsControl ItemsSource="{Binding Transactions}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource ElevatedBrush}" CornerRadius="10" Padding="14" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PackageId}" FontWeight="SemiBold"/><TextBlock Text="{Binding TransactionId}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding CreatedAt}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </Grid>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Reports}">
            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[Reports], Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Texts[Evidence], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,10"/><WrapPanel><Button Content="{Binding Texts[GenerateReport], Mode=OneWay}" Command="{Binding GenerateReportCommand}" Background="{StaticResource AccentBrush}" Foreground="#0B0D12" FontWeight="SemiBold"/><Button Content="{Binding Texts[OpenReportFolder], Mode=OneWay}" Command="{Binding OpenReportsCommand}"/></WrapPanel><ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" MinHeight="130" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FlowDirection="LeftToRight"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding SelectedReport.Name}" Foreground="{StaticResource MutedTextBrush}" FlowDirection="LeftToRight" Margin="0,8"/></StackPanel></Border>
          </Grid>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
            <StackPanel>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[Settings], Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Texts[UiLanguage], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,6"/><WrapPanel><Button Content="{Binding Texts[Arabic], Mode=OneWay}" Command="{Binding SetArabicCommand}"/><Button Content="{Binding Texts[English], Mode=OneWay}" Command="{Binding SetEnglishCommand}"/></WrapPanel></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding Texts[PackageFolder], Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding PackageDirectory}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8" FlowDirection="LeftToRight"/><Button Content="{Binding Texts[Browse], Mode=OneWay}" Command="{Binding BrowsePackageCommand}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Texts[DataPolicy], Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,15,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>

          <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Activity}">
            <Border Style="{StaticResource CardBorder}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="{Binding Texts[Refresh], Mode=OneWay}" Command="{Binding RefreshActivityCommand}"/><TextBlock Text="{Binding Texts[Activity], Mode=OneWay}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Activity}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource ElevatedBrush}" CornerRadius="9" Padding="12" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding Category}"/><TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>



