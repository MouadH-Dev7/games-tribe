<Window x:Class="HollowKnightArabicLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/ArabifyApp.ico" ShowInTaskbar="True"
        Title="Arabify | Hollow Knight Godmaster" Height="560" Width="760" MinHeight="540" MinWidth="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        FlowDirection="{Binding CurrentFlowDirection}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" FlowDirection="LeftToRight" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="pack://application:,,,/Assets/ArabifyAppIcon.png" Width="58" Height="58" Margin="0,0,16,0" Stretch="Uniform" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="LeftToRight">
                <TextBlock Text="Arabify" Foreground="{StaticResource AccentBrush}" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Hollow Knight · Godmaster" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="مجلد اللعبة" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                <DockPanel Margin="0,8,0,5">
                    <Button DockPanel.Dock="Left" Content="اختيار مجلد اللعبة" Click="BrowseGame_Click" />
                    <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" />
                </DockPanel>
                <Button HorizontalAlignment="Right" Content="بحث تلقائي عن اللعبة" Command="{Binding AutoSearchGameCommand}" />
                <TextBlock Text="{Binding GameStatusText}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="4,5,4,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="17" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="حالة التعريب" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PackageStatusText}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="4,7,4,0" />
                    <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,9,4,0" />
                    <ProgressBar Height="6" Margin="4,12,4,0" IsIndeterminate="{Binding IsIndeterminate}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="تثبيت التعريب" Command="{Binding InstallCommand}" MinWidth="150" />
                <Button Content="إلغاء التعريب واستعادة الأصل" Command="{Binding UninstallCommand}" MinWidth="190" />
                <Button Content="استعادة عملية متوقفة" Command="{Binding RecoverCommand}" IsEnabled="{Binding CanRecover}" Visibility="{Binding CanRecover, Converter={StaticResource BoolToVisibilityConverter}}" />
            </WrapPanel>
            <TextBlock Text="Arabify" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Window>

